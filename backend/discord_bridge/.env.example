# ==============================================================================
# J.A.R.V.I.S. Discord Bridge Konfiguration
# ==============================================================================

# Discord Bot Token aus dem Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Optionale kommagetrennte Liste von Discord User-IDs für administrative Befehle (/start, /stop, /restart)
# Wenn leer, darf jeder auf dem Server die Befehle ausführen.
# Beispiel: DISCORD_ADMIN_IDS=123456789012345678,987654321098765432
DISCORD_ADMIN_IDS=

# Optionale Standard-Kanal-ID für autonome J.A.R.V.I.S. Ankündigungen und Systemmeldungen
DISCORD_NOTIFY_CHANNEL_ID=

# J.A.R.V.I.S. WebSocket Core Anbindung (Standard: ws://127.0.0.1:8765)
JARVIS_WS_HOST=127.0.0.1
JARVIS_WS_PORT=8765
JARVIS_WS_URL=ws://127.0.0.1:8765
