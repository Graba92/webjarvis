# ==============================================================================
# J.A.R.V.I.S. AI OS — Environment Configuration Template
# Kopiere diese Datei nach '.env' und passe deine Werte an:
# cp .env.example .env
# ==============================================================================

# ── Google Gemini Live API Key (Erforderlich für Audio & KI-Funktionen) ───────
# Kostenfrei generierbar unter: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# ── J.A.R.V.I.S. WebSocket Gateway ────────────────────────────────────────────
JARVIS_WS_HOST=127.0.0.1
JARVIS_WS_PORT=8765

# ── Benutzer- & Systemkonfiguration ──────────────────────────────────────────
# Name des Benutzers für die KI-Anrede
JARVIS_USER_NAME=Operator
# Modell (Standard: gemini-3.1-flash-live-preview)
JARVIS_MODEL=models/gemini-3.1-flash-live-preview
# Stimme: Puck, Charon, Kore, Fenrir, Aoede
JARVIS_VOICE=Puck

# ── Discord Gateway Bridge (Optional) ────────────────────────────────────────
# Bot-Token aus dem Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Optionale Benutzer-ID(s) für Admin-Rechte (kommagetrennt)
DISCORD_ADMIN_IDS=
# Optionaler Standard-Kanal für proaktive Benachrichtigungen
DISCORD_NOTIFY_CHANNEL_ID=

# ── WhatsApp Multi-Device Gateway Bridge (Optional) ──────────────────────────
WHATSAPP_PORT=3001
